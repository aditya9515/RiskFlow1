# Copy this file to .env for Docker Compose local development only.
# Use a URL-safe password because Compose builds PostgreSQL connection URLs from it.
POSTGRES_USER=riskflow
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=riskflow
POSTGRES_PORT=5432

HTTP_PORT=8080
READINESS_TIMEOUT=1s
PAYMENT_CREATE_TIMEOUT=3s
SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info

KAFKA_PORT=9092
KAFKA_TOPIC=payments.created
RISK_DECISIONS_TOPIC=risk.decisions
RISK_INVALID_EVENTS_TOPIC=risk.invalid-events
OUTBOX_POLL_INTERVAL=250ms
OUTBOX_PUBLISH_TIMEOUT=5s
OUTBOX_RETRY_MIN_BACKOFF=100ms
OUTBOX_RETRY_MAX_BACKOFF=5s
REDIS_PORT=6379

# Deterministic risk worker. Empty merchant/country sets disable those optional rules.
RISK_CONSUMER_GROUP=riskflow-deterministic-rules-v1
REDIS_KEY_PREFIX=riskflow:risk:v1
RISK_POLL_TIMEOUT=1
RISK_PUBLISH_TIMEOUT=5
RISK_RETRY_BACKOFF=1
VELOCITY_WINDOW_SECONDS=300
EVENT_CACHE_TTL_SECONDS=2592000
FEATURE_STATE_TTL_SECONDS=2592000
HIGH_AMOUNT_MINOR=100000
EXTREME_AMOUNT_MINOR=500000
REVIEW_THRESHOLD=40
BLOCK_THRESHOLD=70
RISKY_MERCHANT_IDS=
HIGH_RISK_COUNTRIES=
