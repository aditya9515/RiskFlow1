# Copy this file to .env for Docker Compose local development only.
# Use a URL-safe password because Compose builds PostgreSQL connection URLs from it.
POSTGRES_USER=riskflow
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=riskflow
POSTGRES_PORT=5432

HTTP_PORT=8080
DASHBOARD_PORT=3000
READINESS_TIMEOUT=1s
PAYMENT_CREATE_TIMEOUT=3s
REVIEW_REQUEST_TIMEOUT=3s
DASHBOARD_REQUEST_TIMEOUT=5s
METRICS_COLLECTION_TIMEOUT=1s
METRICS_SHUTDOWN_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info

# Replace both tokens before use. Tokens must be at least 32 characters.
REVIEW_AUTH_CREDENTIALS_JSON=[{"reviewer_id":"local-reviewer","role":"risk_reviewer","token":"replace_with_reviewer_token_32_chars"},{"reviewer_id":"local-auditor","role":"risk_auditor","token":"replace_with_auditor_token_32_chars_"}]

# Must exactly match one risk_reviewer or risk_auditor token above. This value is
# read only by the Next.js server and must never use a NEXT_PUBLIC_ prefix.
DASHBOARD_API_TOKEN=replace_with_auditor_token_32_chars_
DASHBOARD_RECENT_LIMIT=20
DASHBOARD_FETCH_TIMEOUT_MS=7000

KAFKA_PORT=9092
KAFKA_TOPIC=payments.created
RISK_DECISIONS_TOPIC=risk.decisions
RISK_INVALID_EVENTS_TOPIC=risk.invalid-events
OUTBOX_POLL_INTERVAL=250ms
OUTBOX_PUBLISH_TIMEOUT=5s
OUTBOX_RETRY_MIN_BACKOFF=100ms
OUTBOX_RETRY_MAX_BACKOFF=5s
OUTBOX_METRICS_ADDR=:9091
REDIS_PORT=6379

# Deterministic risk worker. Empty merchant/country sets disable those optional rules.
RISK_CONSUMER_GROUP=riskflow-risk-ensemble-v2
REDIS_KEY_PREFIX=riskflow:risk:v1
RISK_POLL_TIMEOUT=1
RISK_PUBLISH_TIMEOUT=5
RISK_RETRY_BACKOFF=1
VELOCITY_WINDOW_SECONDS=300
EVENT_CACHE_TTL_SECONDS=2592000
FEATURE_STATE_TTL_SECONDS=2592000
HIGH_AMOUNT_MINOR=100000
EXTREME_AMOUNT_MINOR=500000
REVIEW_THRESHOLD=40
BLOCK_THRESHOLD=70
RISKY_MERCHANT_IDS=
HIGH_RISK_COUNTRIES=
ML_MODEL_PATH=/app/artifacts/risk_model_xgb_synthetic_v1.json
ML_MODEL_METADATA_PATH=/app/artifacts/risk_model_xgb_synthetic_v1.metadata.json

# PostgreSQL persistence of schema-v2 decisions and the one-shot exception report.
DECISION_CONSUMER_GROUP=riskflow-decision-persistence-v1
DECISION_AUTO_OFFSET_RESET=earliest
DECISION_PROCESS_TIMEOUT=5s
DECISION_RETRY_BACKOFF=1s
DECISION_METRICS_ADDR=:9092
RECONCILIATION_GRACE_PERIOD=30s
RECONCILIATION_TIMEOUT=10s

# Spark Structured Streaming lake ingestion.
SPARK_MASTER=local[2]
SPARK_OUTPUT_ROOT=/var/lib/riskflow/streaming/data
SPARK_CHECKPOINT_ROOT=/var/lib/riskflow/streaming/checkpoints
SPARK_STARTING_OFFSETS=earliest
SPARK_TRIGGER_INTERVAL=5 seconds
SPARK_MAX_OFFSETS_PER_TRIGGER=10000
